# ---------------------------------------------------------------
# HR Attendance — environment configuration
# Copy to .env.local and adjust.
# ---------------------------------------------------------------

# Database driver: "json" (local files, default) or "mongo" (MongoDB Atlas)
DB_DRIVER=json

# JSON driver: directory holding one JSON file per collection
DATA_DIR=./data

# MongoDB Atlas (Free Tier works fine)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=hr_attendance

# Cloud mirror: keep JSON as the database and copy every change to MongoDB.
# Needs MONGODB_URI. Check with: npm run mirror -- check   |   full copy: npm run mirror -- sync
# MONGO_MIRROR=true

# Public base URL used to build password-reset / invitation links (include the sub-path, if any)
APP_URL=http://localhost:3000

# Serve the app under a sub-path, e.g. https://plantopiaforms.com/HRmanagement.
# Build-time setting: run `npm run build` after changing it. Leave empty for the domain root.
# NEXT_PUBLIC_BASE_PATH=/HRmanagement

# Session lifetime (hours). "Remember session" extends to SESSION_REMEMBER_DAYS.
SESSION_TTL_HOURS=12
SESSION_REMEMBER_DAYS=30

# Set to "true" only behind HTTPS (production). Marks cookies Secure.
COOKIE_SECURE=false

# Development helper: show password-reset links in the API response
# instead of requiring an email service. NEVER enable in production.
DEV_SHOW_RESET_LINKS=true

# Field-level encryption key for Aadhaar numbers (32 bytes, base64).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Dev fallback: auto-generated in DATA_DIR/.encryption-key. Keep the SAME key when
# moving to MongoDB Atlas, otherwise stored Aadhaar numbers cannot be decrypted.
# DATA_ENCRYPTION_KEY=
